{
  "name": "ohio-parent-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "npm run data:validate && npm run lint && npm run typecheck && npm run test:unit && npm run test:build",
    "test:unit": "node scripts/test-environment.mjs run unit",
    "test:integration": "node scripts/test-environment.mjs run integration",
    "test:e2e": "node scripts/test-environment.mjs run e2e",
    "test:build": "node scripts/test-environment.mjs run build",
    "test:start": "node scripts/test-environment.mjs run start",
    "test:setup": "node scripts/test-environment.mjs setup",
    "test:reset": "node scripts/test-environment.mjs reset",
    "test:stop": "node scripts/test-environment.mjs stop",
    "test:teardown": "node scripts/test-environment.mjs teardown",
    "city:normalize:report": "node scripts/cityNormalizationReport.mjs",
    "predev": "npm run data:validate",
    "prebuild": "npm run data:validate",
    "data:validate": "node scripts/buildDaycaresJson.mjs validate",
    "data:refresh": "node scripts/buildDaycaresJson.mjs stage",
    "data:apply": "node scripts/buildDaycaresJson.mjs apply",
    "data:geocode": "node scripts/geocodeDaycares_clean.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.1.0",
    "form-data": "^4.0.5",
    "googleapis": "^171.4.0",
    "leaflet": "^1.9.4",
    "leaflet-gesture-handling": "^1.2.2",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.574.0",
    "next": "16.1.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.0.0",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.5",
    "supabase": "2.99.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "5.0.4"
  }
}
