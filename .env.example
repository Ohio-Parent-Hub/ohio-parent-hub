# Local development template only. Copy to .env.local; do not put real credentials here.
# Start the dedicated local stack with npm run test:setup first.
# Fill only the local stack's keys from npx --no-install supabase status -o env.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55431
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never rename this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# Deliberately inert values: local fixtures only, no Stripe API/payment access.
# Hosted configuration needs separately confirmed account/mode-specific values.
STRIPE_SECRET_KEY=sk_test_oph_inert_placeholder
STRIPE_PRICE_ID=price_oph_fixture
STRIPE_WEBHOOK_SECRET=whsec_oph_fixture

# Optional; leave analytics disabled in local development and tests.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional intentional sitemap-wide lastModified override (ISO date/timestamp).
SITEMAP_LASTMOD=

# Optional standalone GSC CLI configuration; Node scripts do not auto-load this file.
# GSC_KEY_FILE=/absolute/private/path/to/service-account.json
# GSC_SITE_URL=sc-domain:ohioparenthub.com
